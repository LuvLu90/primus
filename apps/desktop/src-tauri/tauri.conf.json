{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Primus",
  "mainBinaryName": "Primus",
  "identifier": "com.primus.desktop",
  "version": "0.0.6",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm next dev",
    "beforeBuildCommand": "pnpm next build"
  },
  "app": {
    "windows": [
      {
        "title": "乾元 Primus",
        "width": 1280,
        "height": 800,
        "minWidth": 396,
        "center": true,
        "minHeight": 640,
        "decorations": false,
        "shadow": true,
        "transparent": true,
        "windowEffects": { "effects": ["acrylic"] },
        "label": "main",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "publisher": "乾元 Primus",
    "licenseFile": "windows/Privacy.rtf",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/art/nsis-header.bmp",
        "sidebarImage": "windows/art/nsis-sidebar.bmp",
        "installerHooks": "windows/nsis/hooks.nsh"
      }
    }
  }
}
